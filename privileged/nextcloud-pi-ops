cmd_drill_check() { [[ $# == 1 ]] || invalid; reject_stdin; valid_id "$1" || invalid; validate_host; [[ ! -e "$(drill_unit "$1")" && ! -L "$(drill_unit "$1")" ]] || die "drill unit exists"; out state available; out id "$1"; }
cmd_drill_apply() { [[ $# == 1 ]] || invalid; reject_stdin; local id="$1" unit required_unit; valid_id "$id" || invalid; lock; validate_host; unit="$(drill_unit "$id")"; required_unit="nextcloud-pi-drill-required-$id.service"; [[ ! -e "$unit" && ! -L "$unit" ]] || die "drill unit exists"; printf '[Unit]\nDescription=Disposable Nextcloud Pi drill\nRequires=%s\n[Service]\nType=oneshot\nExecStart=/usr/bin/true\n' "$required_unit" | /usr/bin/install -m 0644 -o root -g root /dev/stdin "$unit"; trap '/usr/bin/rm -f -- "$unit"; /usr/bin/systemctl daemon-reload >/dev/null 2>&1 || true' EXIT HUP INT TERM; /usr/bin/systemctl daemon-reload; if /usr/bin/systemctl start "nextcloud-pi-drill-$id.service" >/dev/null 2>&1; then die "drill dependency unexpectedly succeeded"; fi; /usr/bin/rm -f -- "$unit"; /usr/bin/systemctl daemon-reload; [[ ! -e "$unit" ]] || die "drill rollback failed"; trap - EXIT HUP INT TERM; out state rolledback; out id "$id"; }
cmd_drill_cleanup() { [[ $# == 1 ]] || invalid; reject_stdin; valid_id "$1" || invalid; lock; validate_host; [[ ! -L "$(drill_unit "$1")" ]] || die "drill unit is unsafe"; /usr/bin/rm -f -- "$(drill_unit "$1")"; /usr/bin/systemctl daemon-reload; out state absent; out id "$1"; }

load_policy
if [[ "${1:-}" == upgrade-freeze-boot-guard ]]; then
  [[ "$EUID" == 0 && -z "${SUDO_USER:-}" ]] || die "boot guard requires systemd root context"
  shift; validate_installation; cmd_upgrade_freeze_boot_guard "$@"; exit 0
fi
if [[ "${1:-}" == upgrade-startup-guard ]]; then
  [[ "$EUID" == 0 && -z "${SUDO_USER:-}" ]] || die "startup guard requires systemd root context"
  shift; validate_installation; cmd_upgrade_startup_guard "$@"; exit 0
fi
require_caller
validate_installation
command="${1:-}"; [[ -n "$command" && "$command" != -* ]] || invalid; shift || true
case "$command" in
  version) cmd_version "$@";; check) cmd_check "$@";; protected-state) cmd_protected_state "$@";; active-images-state) cmd_active_images_state "$@";; service) cmd_service "$@";;
  background-jobs) sub="${1:-}"; shift || true; case "$sub" in state) cmd_background_jobs_state "$@";; pause) cmd_background_jobs_pause "$@";; resume) cmd_background_jobs_resume "$@";; *) invalid;; esac;;
  upgrade-freeze) sub="${1:-}"; shift || true; case "$sub" in check) cmd_upgrade_freeze_check "$@";; status) cmd_upgrade_freeze_status "$@";; quiescence) cmd_upgrade_freeze_quiescence "$@";; maintenance-off) cmd_upgrade_freeze_maintenance_off "$@";; activate) cmd_upgrade_freeze_activate "$@";; release) cmd_upgrade_freeze_release "$@";; *) invalid;; esac;;
  upgrade-fetch) sub="${1:-}"; shift || true; case "$sub" in status) cmd_upgrade_fetch_status "$@";; consume) cmd_upgrade_fetch_consume "$@";; complete) cmd_upgrade_fetch_complete "$@";; *) invalid;; esac;;
  upgrade-stage) sub="${1:-}"; shift || true; case "$sub" in consume) cmd_upgrade_stage_consume "$@";; boundary) cmd_upgrade_stage_boundary "$@";; status) cmd_upgrade_stage_status "$@";; abort) cmd_upgrade_stage_abort "$@";; maintenance-off) cmd_upgrade_stage_maintenance_off "$@";; accept) cmd_upgrade_stage_accept "$@";; recovered) cmd_upgrade_stage_recovered "$@";; *) invalid;; esac;;
  db-cutover) sub="${1:-}"; shift || true; case "$sub" in begin) cmd_db_cutover_begin "$@";; env-install) cmd_db_cutover_env_install "$@";; temp-start) cmd_db_cutover_temp_start "$@";; reset-preparing) cmd_db_cutover_reset_preparing "$@";; attest) cmd_db_cutover_attest "$@";; detach) cmd_db_cutover_detach "$@";; switch) cmd_db_cutover_switch "$@";; candidate-ready) cmd_db_cutover_candidate_ready "$@";; running) cmd_db_cutover_running "$@";; accepted) cmd_db_cutover_accepted "$@";; abort) cmd_db_cutover_abort "$@";; recovery-detach) cmd_db_cutover_recovery_detach "$@";; source-ready) cmd_db_cutover_source_ready "$@";; recovered) cmd_db_cutover_recovered "$@";; status) cmd_db_cutover_status "$@";; *) invalid;; esac;;
  active-record) sub="${1:-}"; shift || true; case "$sub" in presence) cmd_active_presence "$@";; status) cmd_active_status "$@";; prepare) cmd_active_prepare "$@";; apply) cmd_active_apply "$@";; rollback) cmd_active_rollback "$@";; commit) cmd_active_commit "$@";; *) invalid;; esac;;
  runtime-backup) sub="${1:-}"; shift || true; case "$sub" in size) cmd_runtime_backup_size "$@";; stream) cmd_runtime_backup_stream "$@";; *) invalid;; esac;;
  runtime-recovery) sub="${1:-}"; shift || true; case "$sub" in check) cmd_recovery_check "$@";; status) cmd_recovery_status "$@";; prepare) cmd_recovery_prepare "$@";; reset-prepared) cmd_recovery_reset_prepared "$@";; restore) cmd_recovery_restore "$@";; attest-database) cmd_recovery_attest_database "$@";; promote) cmd_recovery_promote "$@";; cleanup) cmd_recovery_cleanup "$@";; *) invalid;; esac;;
  image-readiness) sub="${1:-}"; shift || true; case "$sub" in check) cmd_readiness_check "$@";; start) cmd_readiness_start "$@";; status) cmd_readiness_status "$@";; stop) cmd_readiness_stop "$@";; cleanup) cmd_readiness_cleanup "$@";; *) invalid;; esac;;
  deployment-drill) sub="${1:-}"; shift || true; case "$sub" in check) cmd_drill_check "$@";; apply) cmd_drill_apply "$@";; cleanup) cmd_drill_cleanup "$@";; *) invalid;; esac;;
  *) invalid;;
esac
