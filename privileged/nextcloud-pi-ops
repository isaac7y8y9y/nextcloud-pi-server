  fi
  db_cutover_rewrite "$id" aborted "$(db_cutover_field "$id" objects_removed)" "$(db_cutover_field "$id" candidate_inode)" "$(db_cutover_field "$id" candidate_digest)"
  out phase aborted; out id "$id"
}
cmd_db_cutover_recovery_detach() {
  [[ $# == 3 ]] || invalid; reject_stdin
  local id="$1" fingerprint="$2" stage_fingerprint="$3" phase state file name key expected actual project_label
  lock; validate_host; db_cutover_require "$id" "$fingerprint"; db_cutover_stage_bound "$id" "$stage_fingerprint"
  [[ "$(upgrade_stage_field "$id" phase)" == runtime-may-have-changed ]] || die "database stage is not recoverable"
  state="$(recovery_state "$id")"; safe_dir "$state"; file="$state/metadata.tsv"; protected_file "$file" 0600
  [[ "$(metadata "$file" state)" == prepared || "$(metadata "$file" state)" == promoting ]] || die "runtime recovery has not been staged"
  for key in nextcloud caddy-data caddy-config database; do protected_file "$state/$key.complete" 0600; done
  phase="$(db_cutover_field "$id" phase)"
  [[ "$phase" == switching || "$phase" == candidate-ready || "$phase" == starting || "$phase" == running || "$phase" == recovery-detaching || "$phase" == recovering ]] || die "database recovery phase is invalid"
  [[ -d "${P[NEXTCLOUD_PI_STORAGE_MOUNT]}/nextcloud_db" && ! -L "${P[NEXTCLOUD_PI_STORAGE_MOUNT]}/nextcloud_db" && "$(db_cutover_inode "${P[NEXTCLOUD_PI_STORAGE_MOUNT]}/nextcloud_db")" == "$(db_cutover_field "$id" candidate_inode)" ]] || die "candidate database is not in canonical position"
  [[ "$(/usr/bin/systemctl is-active "${P[NEXTCLOUD_PI_SERVICE_NAME]}" 2>/dev/null || true)" =~ ^(inactive|failed)$ ]] || die "candidate service must be stopped before recovery"
  if [[ "$phase" != recovering ]]; then
    db_cutover_rewrite "$id" recovery-detaching yes "$(db_cutover_field "$id" candidate_inode)" "$(db_cutover_field "$id" candidate_digest)"
  fi
  for key in APP DB CADDY; do
    case "$key" in APP) name="${P[NEXTCLOUD_PI_APP_CONTAINER]}";; DB) name="${P[NEXTCLOUD_PI_DB_CONTAINER]}";; CADDY) name="${P[NEXTCLOUD_PI_CADDY_CONTAINER]}";; esac
    actual="$(/usr/bin/docker inspect --format '{{.Image}} {{.State.Running}} {{index .Config.Labels "com.docker.compose.project"}}' "$name" 2>/dev/null || true)"
    [[ -z "$actual" ]] && continue
    expected="$(/usr/bin/awk -F= -v wanted="NEXTCLOUD_ACTIVE_IMAGES_${key}_ID" '$1 == wanted {print $2}' "$ACTIVE_RECORD")"
    project_label="${P[NEXTCLOUD_PI_PROJECT_DIR]##*/}"
    [[ ( "$actual" == "$expected false $project_label" || "$actual" == "$expected true $project_label" ) && "$(live_hash)" == "$(db_cutover_field "$id" candidate_record_sha256)" ]] || die "candidate container differs during recovery"
    /usr/bin/docker update --restart=no "$name" >/dev/null
    if [[ "$actual" == "$expected true $project_label" ]]; then
      /usr/bin/docker stop --time 120 "$name" >/dev/null || die "candidate container did not stop cleanly"
      [[ "$(/usr/bin/docker inspect --format '{{.State.Running}}' "$name")" == false ]] || die "candidate container remains running"
    fi
    /usr/bin/docker rm "$name" >/dev/null
  done
  db_cutover_old_objects_absent "$id"
  db_cutover_rewrite "$id" recovering yes "$(db_cutover_field "$id" candidate_inode)" "$(db_cutover_field "$id" candidate_digest)"
  out phase recovering; out id "$id"
}
cmd_db_cutover_source_ready() {
