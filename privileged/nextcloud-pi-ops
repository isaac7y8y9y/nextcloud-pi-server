  [[ "$(db_cutover_inode "$(db_cutover_path "$id")")" == "$(db_cutover_field "$id" candidate_inode)" && "$(db_cutover_digest "$(db_cutover_path "$id")")" == "$(db_cutover_field "$id" candidate_digest)" ]] || die "prepared database changed"
