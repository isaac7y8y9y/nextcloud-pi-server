cmd_db_cutover_abort() {
  [[ $# == 2 ]] || invalid; reject_stdin
  local id="$1" fingerprint="$2" phase live data stage key name expected actual
  lock; validate_host; db_cutover_require "$id" "$fingerprint"
  phase="$(db_cutover_field "$id" phase)"
  [[ "$phase" == preparing || "$phase" == prepared || "$phase" == detaching || "$phase" == detached ]] || die "database cutover crossed the full recovery boundary"
  live="${P[NEXTCLOUD_PI_STORAGE_MOUNT]}/nextcloud_db"; data="$(db_cutover_path "$id")"
  [[ -d "$live" && ! -L "$live" && "$(db_cutover_inode "$live")" == "$(db_cutover_field "$id" source_inode)" && "$(live_hash)" == "$(db_cutover_field "$id" pre_record_sha256)" && "$(upgrade_stage_compose_hash)" == "$(db_cutover_field "$id" pre_compose_sha256)" ]] || die "source database or configuration changed"
  [[ ! -e "${P[NEXTCLOUD_PI_STORAGE_MOUNT]}/.nextcloud-db-before-$id" && ! -L "${P[NEXTCLOUD_PI_STORAGE_MOUNT]}/.nextcloud-db-before-$id" ]] || die "database switch may have begun"
  stage="$(upgrade_stage_file "$id")"
  if [[ -e "$stage" || -L "$stage" ]]; then
    protected_file "$stage" 0600
    [[ "$(upgrade_stage_field "$id" phase)" == aborted ]] || die "activation stage must be aborted first"
  fi
  [[ -d "$data" && ! -L "$data" ]] || die "database staging directory is unsafe"
  no_nested_mounts "$data" || die "database staging contains a nested mount"
  db_cutover_no_consumers "$data"
  if [[ "$phase" == detaching || "$phase" == detached ]]; then
    /usr/bin/systemctl stop "${P[NEXTCLOUD_PI_SERVICE_NAME]}" || die "source service did not stop during abort"
    for key in app db caddy; do
      case "$key" in app) name="${P[NEXTCLOUD_PI_APP_CONTAINER]}";; db) name="${P[NEXTCLOUD_PI_DB_CONTAINER]}";; caddy) name="${P[NEXTCLOUD_PI_CADDY_CONTAINER]}";; esac
      expected="$(db_cutover_field "$id" "${key}_container_id")"
      actual="$(/usr/bin/docker inspect --format '{{.Id}} {{.State.Running}}' "$name" 2>/dev/null || true)"
      [[ -z "$actual" || "$actual" == "$expected false" || "$actual" == "$expected true" ]] || die "source container identity differs during abort"
      if [[ -n "$actual" ]]; then
        /usr/bin/docker update --restart=no "$name" >/dev/null
        [[ "$actual" != "$expected true" ]] || /usr/bin/docker stop --time 120 "$name" >/dev/null
        /usr/bin/docker rm "$name" >/dev/null
      fi
    done
