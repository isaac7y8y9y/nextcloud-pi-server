#!/bin/bash
set -euo pipefail

# The only passwordless root entry point. Inputs select fixed logical actions;
# all authority values and paths come from the root-owned policy.
readonly POLICY=/etc/nextcloud-pi/privileged-policy.conf
readonly MANIFEST=/etc/nextcloud-pi/bundle-manifest.tsv
readonly HELPER=/usr/local/libexec/nextcloud-pi-ops
readonly VALIDATOR=/usr/local/libexec/nextcloud-pi-validate-active-images
readonly ACTIVE_RECORD=/etc/nextcloud-pi/active-images.env
readonly LOCK_ROOT=/run/nextcloud-pi-locks
readonly LOCK="$LOCK_ROOT/operations.lock"
ACTIVE_PREPARE_ABORT_TX=''
export PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C LANG=C
umask 077
unset CDPATH ENV BASH_ENV GLOBIGNORE SHELLOPTS 2>/dev/null || true

die() { printf 'nextcloud-pi-ops: %s\n' "$1" >&2; exit 1; }
invalid() { printf 'nextcloud-pi-ops: invalid command or arguments\n' >&2; exit 2; }
out() { printf '%s\t%s\n' "$1" "$2"; }
mode() { /usr/bin/stat -c '%a' "$1"; }
uid() { /usr/bin/stat -c '%u' "$1"; }
gid() { /usr/bin/stat -c '%g' "$1"; }
hash() { /usr/bin/sha256sum "$1" | /usr/bin/awk '{print $1}'; }
valid_id() { [[ "$1" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9]+$ ]]; }
valid_hash() { [[ "$1" =~ ^[0-9a-f]{64}$ ]]; }

declare -A P=()
allowed_policy_key() {
  case "$1" in
    NEXTCLOUD_PI_POLICY_FORMAT|NEXTCLOUD_PI_BUNDLE_VERSION|NEXTCLOUD_PI_DEPLOYMENT_USER|NEXTCLOUD_PI_SYSTEM_HOSTNAME|NEXTCLOUD_PI_PROJECT_DIR|NEXTCLOUD_PI_STORAGE_MOUNT|NEXTCLOUD_PI_STORAGE_TYPE|NEXTCLOUD_PI_STORAGE_UUID|NEXTCLOUD_PI_IMAGE_PLATFORM|NEXTCLOUD_PI_SERVICE_NAME|NEXTCLOUD_PI_APP_CONTAINER|NEXTCLOUD_PI_DB_CONTAINER|NEXTCLOUD_PI_CADDY_CONTAINER|NEXTCLOUD_PI_CADDY_DATA_VOLUME|NEXTCLOUD_PI_CADDY_CONFIG_VOLUME|NEXTCLOUD_PI_STATE_ROOT|NEXTCLOUD_PI_SOCKET_ROOT|NEXTCLOUD_PI_RUNTIME_RECOVERY_PREFIX|NEXTCLOUD_PI_IMAGE_READINESS_PREFIX|NEXTCLOUD_PI_MAX_STAGING_BYTES) return 0 ;;
    *) return 1 ;;
  esac
}
protected_file() {
  local path="$1" expected="$2"
  [[ -f "$path" && ! -L "$path" && "$(uid "$path")" == 0 && "$(gid "$path")" == 0 && "$(mode "$path")" == "${expected#0}" ]] || die "protected file is unsafe"
}
protected_parents() {
  local path="$1" parent
  parent="$(/usr/bin/dirname -- "$path")"
  while [[ "$parent" != / ]]; do
    [[ -d "$parent" && ! -L "$parent" && "$(uid "$parent")" == 0 && "$(gid "$parent")" == 0 ]] || die "protected parent is unsafe"
    (( (8#$(mode "$parent") & 8#022) == 0 )) || die "protected parent is writable"
    parent="$(/usr/bin/dirname -- "$parent")"
  done
}
load_policy() {
  local line key value count=0
  protected_file "$POLICY" 0600; protected_parents "$POLICY"
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^([A-Z][A-Z0-9_]*)=([^[:space:]]+)$ ]] || die "policy schema is invalid"
    key="${BASH_REMATCH[1]}"; value="${BASH_REMATCH[2]}"
    allowed_policy_key "$key" || die "policy key is invalid"
    [[ -z "${P[$key]+x}" ]] || die "policy has a duplicate key"
    P[$key]="$value"; count=$((count + 1))
  done <"$POLICY"
  (( count == 20 )) || die "policy is incomplete"
  [[ "${P[NEXTCLOUD_PI_POLICY_FORMAT]}" == nextcloud-pi-privileged-policy-v1 && "${P[NEXTCLOUD_PI_BUNDLE_VERSION]}" =~ ^[1-9][0-9]*$ ]] || die "policy format is invalid"
  [[ "${P[NEXTCLOUD_PI_DEPLOYMENT_USER]}" =~ ^[A-Za-z_][A-Za-z0-9_.-]*$ && "${P[NEXTCLOUD_PI_SYSTEM_HOSTNAME]}" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ ]] || die "policy identity is invalid"
  [[ "${P[NEXTCLOUD_PI_PROJECT_DIR]}" =~ ^/[A-Za-z0-9._/-]+$ && "${P[NEXTCLOUD_PI_PROJECT_DIR]##*/}" == nextcloud-docker ]] || die "policy project is invalid"
  [[ "${P[NEXTCLOUD_PI_STORAGE_MOUNT]}" =~ ^/[A-Za-z0-9._/-]+$ && "${P[NEXTCLOUD_PI_STORAGE_TYPE]}" == ext4 && "${P[NEXTCLOUD_PI_STORAGE_UUID]}" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]] || die "policy storage is invalid"
  [[ "${P[NEXTCLOUD_PI_STATE_ROOT]}" == /var/lib/nextcloud-pi-ops && "${P[NEXTCLOUD_PI_SOCKET_ROOT]}" == /run/nextcloud-pi-ops && "${P[NEXTCLOUD_PI_MAX_STAGING_BYTES]}" =~ ^[1-9][0-9]*$ ]] || die "policy roots are invalid"
}
require_caller() { [[ "$EUID" == 0 && "${SUDO_USER:-}" == "${P[NEXTCLOUD_PI_DEPLOYMENT_USER]}" ]] || die "caller is not authorized"; }
validate_manifest() {
  local kind logical source installed expected digest extra format='' version='' seen='|'
  protected_file "$MANIFEST" 0600; protected_parents "$MANIFEST"
  while IFS=$'\t' read -r kind logical source installed expected digest extra || [[ -n "$kind" ]]; do
    [[ -z "$kind" || "$kind" == \#* ]] && continue
    case "$kind" in
      format) [[ "$logical" == nextcloud-pi-bundle-manifest-v1 && -z "${source:-}" ]] || die "manifest format is invalid"; format="$logical" ;;
      version) [[ "$logical" == "${P[NEXTCLOUD_PI_BUNDLE_VERSION]}" && -z "${source:-}" ]] || die "manifest version is invalid"; version="$logical" ;;
      file)
        [[ "$logical" =~ ^[a-z-]+$ && "$installed" == /* && "$expected" =~ ^0[0-7]{3}$ && "$digest" =~ ^[0-9a-f]{64}$ && -z "${extra:-}" && "$seen" != *"|$logical|"* ]] || die "manifest entry is invalid"
        protected_file "$installed" "$expected"; protected_parents "$installed"; [[ "$(hash "$installed")" == "$digest" ]] || die "installed bundle differs"; seen+="$logical|"
        ;;
      *) die "manifest schema is invalid" ;;
    esac
  done <"$MANIFEST"
  [[ "$format" == nextcloud-pi-bundle-manifest-v1 && "$version" == "${P[NEXTCLOUD_PI_BUNDLE_VERSION]}" ]] || die "manifest is incomplete"
  for logical in privileged-helper active-image-validator compose-launcher nextcloud-unit docker-storage-drop-in; do [[ "$seen" == *"|$logical|"* ]] || die "manifest lacks required file"; done
}
validate_installation() {
  protected_file "$HELPER" 0700; protected_parents "$HELPER"; validate_manifest
  [[ -d "${P[NEXTCLOUD_PI_STATE_ROOT]}" && ! -L "${P[NEXTCLOUD_PI_STATE_ROOT]}" && "$(uid "${P[NEXTCLOUD_PI_STATE_ROOT]}")" == 0 && "$(mode "${P[NEXTCLOUD_PI_STATE_ROOT]}")" == 700 ]] || die "state root is unsafe"
}
validate_host() {
  local target type volume
  [[ "$(/usr/bin/hostname)" == "${P[NEXTCLOUD_PI_SYSTEM_HOSTNAME]}" ]] || die "hostname differs"
  target="$(/usr/bin/findmnt -rn --target "${P[NEXTCLOUD_PI_STORAGE_MOUNT]}" -o TARGET)"; type="$(/usr/bin/findmnt -rn --target "${P[NEXTCLOUD_PI_STORAGE_MOUNT]}" -o FSTYPE)"; volume="$(/usr/bin/findmnt -rn --target "${P[NEXTCLOUD_PI_STORAGE_MOUNT]}" -o UUID)"
  [[ "$target" == "${P[NEXTCLOUD_PI_STORAGE_MOUNT]}" && "$type" == ext4 && "${volume,,}" == "${P[NEXTCLOUD_PI_STORAGE_UUID],,}" ]] || die "storage identity differs"
}
reject_stdin() { local byte; if [[ ! -t 0 ]] && IFS= read -r -n 1 -t 0.05 byte; then invalid; fi; return 0; }
valid_size() { [[ "$1" =~ ^[1-9][0-9]*$ ]] && (( 10#$1 <= 10#${P[NEXTCLOUD_PI_MAX_STAGING_BYTES]} )); }
lock() {
  if [[ -e "$LOCK_ROOT" || -L "$LOCK_ROOT" ]]; then
    [[ -d "$LOCK_ROOT" && ! -L "$LOCK_ROOT" && "$(uid "$LOCK_ROOT")" == 0 && "$(gid "$LOCK_ROOT")" == 0 && "$(mode "$LOCK_ROOT")" == 700 ]] || die "lock root is unsafe"
  else
    /usr/bin/install -d -m 0700 -o root -g root "$LOCK_ROOT"
  fi
  if [[ -e "$LOCK" || -L "$LOCK" ]]; then
    protected_file "$LOCK" 0600
  else
    /usr/bin/install -m 0600 -o root -g root /dev/null "$LOCK"
  fi
  exec 9>>"$LOCK"
  /usr/bin/flock -w 30 9 || die "another operation is running"
  protected_file "$LOCK" 0600
}
state_dir() { printf '%s/%s' "${P[NEXTCLOUD_PI_STATE_ROOT]}" "$1"; }
safe_dir() { [[ -d "$1" && ! -L "$1" && "$(uid "$1")" == 0 && "$(gid "$1")" == 0 && "$(mode "$1")" == 700 ]] || die "state directory is unsafe"; }
no_nested_mounts() { /usr/bin/findmnt -rn -o TARGET | /usr/bin/awk -v path="$1" '$0 == path || index($0, path "/") == 1 { bad = 1 } END { exit bad }'; }
ensure_parent() { local path="$(state_dir "$1")"; if [[ -e "$path" || -L "$path" ]]; then safe_dir "$path"; else /usr/bin/install -d -m 0700 -o root -g root "$path"; fi; }
read_exact() {
  local target="$1" size="$2" extra="$1.extra"
  /usr/bin/dd iflag=fullblock,count_bytes bs=1M count="$size" status=none of="$target" || die "input read failed"
  [[ "$(/usr/bin/stat -c '%s' "$target")" == "$size" ]] || die "input is truncated"
  /usr/bin/dd bs=1 count=1 status=none of="$extra" 2>/dev/null || die "input trailer check failed"
  [[ "$(/usr/bin/stat -c '%s' "$extra")" == 0 ]] || die "input has trailing bytes"
  /usr/bin/rm -f -- "$extra"
}
resource_path() { case "$1" in nextcloud-unit) echo /etc/systemd/system/nextcloud.service;; background-jobs-unit) echo /etc/systemd/system/nextcloud-background-jobs.service;; background-jobs-timer) echo /etc/systemd/system/nextcloud-background-jobs.timer;; docker-storage-drop-in) echo /etc/systemd/system/docker.service.d/nextcloud-storage.conf;; compose-launcher) echo /usr/local/libexec/nextcloud-pi-compose-start;; background-jobs-runner) echo /usr/local/libexec/nextcloud-pi-background-jobs;; active-image-validator) echo "$VALIDATOR";; active-image-record) echo "$ACTIVE_RECORD";; privileged-helper) echo "$HELPER";; privileged-policy) echo "$POLICY";; sudoers-policy) echo /etc/sudoers.d/nextcloud-pi-automation;; *) invalid;; esac; }
resource_mode() { case "$1" in nextcloud-unit|background-jobs-unit|background-jobs-timer|docker-storage-drop-in) echo 0644;; compose-launcher|background-jobs-runner|active-image-validator|privileged-helper) echo 0700;; active-image-record|privileged-policy) echo 0600;; sudoers-policy) echo 0440;; *) invalid;; esac; }
live_hash() { if [[ -f "$ACTIVE_RECORD" && ! -L "$ACTIVE_RECORD" ]]; then hash "$ACTIVE_RECORD"; elif [[ ! -e "$ACTIVE_RECORD" && ! -L "$ACTIVE_RECORD" ]]; then echo missing; else die "active record is unsafe"; fi; }
metadata() { /usr/bin/awk -F $'\t' -v key="$2" '$1 == key { n++; v=$2 } END { if (n == 1) print v; else exit 1 }' "$1"; }
active_root() { state_dir active-record; }
active_tx() { printf '%s/%s' "$(active_root)" "$1"; }
active_marker() { state_dir active-record-current; }
write_active_meta() { printf 'format\tactive-record-v1\nstate\t%s\npre_sha256\t%s\ncandidate_sha256\t%s\nsize\t%s\n' "$2" "$3" "$4" "$5" >"$1.new"; /usr/bin/chmod 0600 "$1.new"; /usr/bin/mv -f "$1.new" "$1"; }
require_active_tx() { local tx="$(active_tx "$1")" marker="$(active_marker)"; valid_id "$1" || invalid; safe_dir "$tx"; protected_file "$marker" 0600; [[ "$(<"$marker")" == "$1" ]] || die "another active transaction owns the record"; protected_file "$tx/metadata.tsv" 0600; }
install_record() { local temp; temp="$(/usr/bin/mktemp /etc/nextcloud-pi/.active-images.XXXXXX)"; /usr/bin/install -m 0600 -o root -g root "$1" "$temp"; /usr/bin/mv -f "$temp" "$ACTIVE_RECORD"; }
active_prepare_abort() { local status="$1" tx="$ACTIVE_PREPARE_ABORT_TX"; trap - EXIT HUP INT TERM; [[ -z "$tx" ]] || /usr/bin/rm -rf --one-file-system -- "$tx"; exit "$status"; }

cmd_version() { [[ $# == 0 ]] || invalid; reject_stdin; out version "${P[NEXTCLOUD_PI_BUNDLE_VERSION]}"; out manifest_sha256 "$(hash "$MANIFEST")"; }
cmd_check() { local program resolved; [[ $# == 0 ]] || invalid; reject_stdin; validate_host; for program in /bin/bash /usr/bin/awk /usr/bin/basename /usr/bin/cp /usr/bin/dd /usr/bin/df /usr/bin/dirname /usr/bin/docker /usr/bin/dockerd /usr/bin/du /usr/bin/find /usr/bin/findmnt /usr/bin/flock /usr/bin/id /usr/bin/install /usr/bin/kill /usr/bin/mktemp /usr/bin/nohup /usr/bin/python3 /usr/bin/readlink /usr/bin/rm /usr/bin/sha256sum /usr/bin/sleep /usr/bin/stat /usr/bin/systemctl /usr/bin/tail /usr/bin/tar /usr/bin/tr; do [[ -x "$program" ]] || die "required program is unavailable"; resolved="$(/usr/bin/readlink -f "$program")"; [[ -f "$resolved" && ! -L "$resolved" && "$(uid "$resolved")" == 0 && "$(gid "$resolved")" == 0 ]] || die "required program is unsafe"; done; out status ok; }
cmd_protected_state() { [[ $# == 1 && "$1" != -* ]] || invalid; reject_stdin; local path expected; path="$(resource_path "$1")"; expected="$(resource_mode "$1")"; if [[ ! -e "$path" && ! -L "$path" ]]; then out state missing; out name "$1"; return; fi; protected_file "$path" "$expected"; protected_parents "$path"; out state present; out name "$1"; out sha256 "$(hash "$path")"; out uid 0; out gid 0; out mode "$expected"; }
cmd_active_images_state() {
  [[ $# == 0 ]] || invalid; reject_stdin; "$VALIDATOR"
  local key
  out status ok
  out mode "$(/usr/bin/awk -F= '$1 == "NEXTCLOUD_ACTIVE_IMAGES_MODE" { print $2 }' "$ACTIVE_RECORD")"
  out sha256 "$(hash "$ACTIVE_RECORD")"
  out source_lock_sha256 "$(/usr/bin/awk -F= '$1 == "NEXTCLOUD_ACTIVE_IMAGES_PROVENANCE_SHA256" { print $2 }' "$ACTIVE_RECORD")"
  for key in APP DB CADDY; do
    out "${key,,}_id" "$(/usr/bin/awk -F= -v wanted="NEXTCLOUD_ACTIVE_IMAGES_${key}_ID" '$1 == wanted { print $2 }' "$ACTIVE_RECORD")"
  done
}
cmd_service() { [[ $# == 1 ]] || invalid; reject_stdin; lock; validate_host; case "$1" in start|restart) /usr/bin/systemctl "$1" "${P[NEXTCLOUD_PI_SERVICE_NAME]}"; /usr/bin/systemctl is-active --quiet "${P[NEXTCLOUD_PI_SERVICE_NAME]}" || die "service is not active";; stop) /usr/bin/systemctl stop "${P[NEXTCLOUD_PI_SERVICE_NAME]}"; [[ "$(/usr/bin/systemctl is-active "${P[NEXTCLOUD_PI_SERVICE_NAME]}" 2>/dev/null || true)" =~ ^(inactive|failed)$ ]] || die "service did not stop";; *) invalid;; esac; out state "$1"; }
background_jobs_timer=nextcloud-background-jobs.timer
background_jobs_service=nextcloud-background-jobs.service
cmd_background_jobs_state() { [[ $# == 0 ]] || invalid; reject_stdin; validate_host; if /usr/bin/systemctl is-enabled --quiet "$background_jobs_timer"; then out timer_enabled yes; else out timer_enabled no; fi; if /usr/bin/systemctl is-active --quiet "$background_jobs_timer"; then out timer_active yes; else out timer_active no; fi; }
cmd_background_jobs_pause() { [[ $# == 0 ]] || invalid; reject_stdin; local state attempt; lock; validate_host; /usr/bin/systemctl stop "$background_jobs_timer"; for attempt in {1..300}; do state="$(/usr/bin/systemctl is-active "$background_jobs_service" 2>/dev/null || true)"; case "$state" in inactive|failed|unknown|'') out state paused; return;; active|activating|deactivating) /usr/bin/sleep 1;; *) die "background job service has an unexpected state";; esac; done; die "background job service did not finish before the five-minute backup wait"; }
cmd_background_jobs_resume() { [[ $# == 0 ]] || invalid; reject_stdin; lock; validate_host; /usr/bin/systemctl start "$background_jobs_timer"; /usr/bin/systemctl is-active --quiet "$background_jobs_timer" || die "background job timer did not start"; out state resumed; }

# A dedicated inet/prerouting rule blocks host-directed Caddy traffic before
# Docker's destination NAT. It applies to both IP families and established
# flows; loopback traffic does not enter this non-loopback rule. An interrupted
# activation intentionally leaves maintenance and the timer paused.
freeze_table=nextcloud_pi_upgrade
freeze_root() { state_dir upgrade-freeze; }
freeze_current() { printf '%s/current.tsv' "$(freeze_root)"; }
freeze_hold() { printf '%s/timer-held' "$(freeze_root)"; }
freeze_used() { printf '%s/used-%s' "$(freeze_root)" "$1"; }
freeze_field() { metadata "$(freeze_current)" "$1"; }
freeze_write() {
  local file="$(freeze_current)" temporary
  temporary="$file.new"
  printf 'format\tupgrade-freeze-v1\nid\t%s\nphase\t%s\ntimer_active\t%s\ntable_sha256\t%s\n' "$1" "$2" "$3" "$4" >"$temporary"
  /usr/bin/chmod 0600 "$temporary"
  /usr/bin/mv -f -- "$temporary" "$file"
}
freeze_table_hash() { /usr/sbin/nft -j list table inet "$freeze_table" | /usr/bin/sha256sum | /usr/bin/awk '{print $1}'; }
freeze_install_rule() {
  /usr/sbin/nft -f - <<'NFT'
add table inet nextcloud_pi_upgrade
add chain inet nextcloud_pi_upgrade ingress { type filter hook prerouting priority -300; policy accept; }
add rule inet nextcloud_pi_upgrade ingress iifname != "lo" fib daddr type local tcp dport { 80, 443 } drop
NFT
}
freeze_require_current() {
  local file="$(freeze_current)" id="$1" phase timer table
  valid_id "$id" || invalid
  safe_dir "$(freeze_root)"; protected_file "$file" 0600
  [[ "$(freeze_field format)" == upgrade-freeze-v1 && "$(freeze_field id)" == "$id" ]] || die "freeze transaction differs"
  phase="$(freeze_field phase)"; timer="$(freeze_field timer_active)"; table="$(freeze_field table_sha256)"
  [[ "$phase" == preparing || "$phase" == active || "$phase" == releasing ]] || die "freeze phase is invalid"
  [[ "$timer" == yes || "$timer" == no ]] || die "freeze timer state is invalid"
  [[ "$table" == pending || "$table" =~ ^[0-9a-f]{64}$ ]] || die "freeze table identity is invalid"
}
cmd_upgrade_freeze_check() {
  [[ $# == 1 ]] || invalid; reject_stdin; valid_id "$1" || invalid; validate_host
  [[ -x /usr/sbin/nft && ! -L /usr/sbin/nft ]] || die "nftables is unavailable"
  local root="$(freeze_root)" current="$(freeze_current)"
  if [[ -e "$root" || -L "$root" ]]; then
    safe_dir "$root"
    [[ ! -e "$current" && ! -L "$current" && ! -e "$(freeze_used "$1")" && ! -L "$(freeze_used "$1")" ]] || die "freeze lifecycle already exists"
  fi
  ! /usr/sbin/nft list table inet "$freeze_table" >/dev/null 2>&1 || die "upgrade firewall table already exists"
  /usr/bin/docker port "${P[NEXTCLOUD_PI_CADDY_CONTAINER]}" 80/tcp >/dev/null || die "Caddy HTTP is not published"
  /usr/bin/docker port "${P[NEXTCLOUD_PI_CADDY_CONTAINER]}" 443/tcp >/dev/null || die "Caddy HTTPS is not published"
  [[ ! -e "$(active_marker)" && ! -L "$(active_marker)" ]] || die "an active-image transaction is unresolved"
  out state available; out id "$1"
}
cmd_upgrade_freeze_status() {
  [[ $# == 0 ]] || invalid; reject_stdin; validate_host
  local root="$(freeze_root)" current="$(freeze_current)" phase table
  if [[ ! -e "$root" && ! -L "$root" ]]; then
    ! /usr/sbin/nft list table inet "$freeze_table" >/dev/null 2>&1 || die "orphaned upgrade firewall table"
    out state absent; return
  fi
  safe_dir "$root"
  if [[ ! -e "$current" && ! -L "$current" ]]; then
    ! /usr/sbin/nft list table inet "$freeze_table" >/dev/null 2>&1 || die "orphaned upgrade firewall table"
    out state absent; return
  fi
  protected_file "$current" 0600
  freeze_require_current "$(freeze_field id)"
  phase="$(freeze_field phase)"; table="$(freeze_field table_sha256)"
  if [[ "$phase" == active ]]; then
    [[ "$(freeze_table_hash)" == "$table" ]] || die "upgrade firewall differs from its protected state"
  fi
  out state "$phase"; out id "$(freeze_field id)"; out table_sha256 "$table"; out timer_was_active "$(freeze_field timer_active)"
}
cmd_upgrade_freeze_boot_guard() {
  [[ $# == 0 ]] || invalid
  local current="$(freeze_current)" root="$(freeze_root)" phase table metadata_file
  lock; validate_host
  for metadata_file in "${P[NEXTCLOUD_PI_STATE_ROOT]}"/runtime-recovery/*/metadata.tsv; do
    [[ -e "$metadata_file" || -L "$metadata_file" ]] || continue
    protected_file "$metadata_file" 0600
    [[ "$(metadata "$metadata_file" state)" != promoting ]] || die "partial runtime promotion blocks Docker start"
  done
  if [[ ! -e "$root" && ! -L "$root" ]]; then
    ! /usr/sbin/nft list table inet "$freeze_table" >/dev/null 2>&1 || die "orphaned upgrade firewall table"
    return
  fi
  safe_dir "$root"
  if [[ ! -e "$current" && ! -L "$current" ]]; then
    ! /usr/sbin/nft list table inet "$freeze_table" >/dev/null 2>&1 || die "orphaned upgrade firewall table"
    return
  fi
  protected_file "$current" 0600; freeze_require_current "$(freeze_field id)"
  phase="$(freeze_field phase)"; table="$(freeze_field table_sha256)"
  [[ "$phase" == active || "$phase" == releasing ]] || die "unresolved freeze phase blocks Docker start"
  if [[ -e "$(freeze_hold)" || -L "$(freeze_hold)" ]]; then
    protected_file "$(freeze_hold)" 0600
  else
    /usr/bin/install -m 0600 -o root -g root /dev/null "$(freeze_hold)"
  fi
  # The service unit independently refuses jobs while current.tsv exists.
  /usr/bin/systemctl stop "$background_jobs_timer" || die "could not pause background-job timer during boot"
  ! /usr/bin/systemctl is-active --quiet "$background_jobs_timer" || die "background-job timer remains active during boot"
  if ! /usr/sbin/nft list table inet "$freeze_table" >/dev/null 2>&1; then
    freeze_install_rule || die "could not restore upgrade firewall before Docker start"
  fi
  [[ "$(freeze_table_hash)" == "$table" ]] || die "boot-restored upgrade firewall differs"
}
freeze_socket_count() {
  /usr/bin/docker exec "$1" /usr/bin/awk '$4 == "01" { count++ } END { print count+0 }' /proc/net/tcp /proc/net/tcp6
}
freeze_database_count() {
  /usr/bin/docker exec "${P[NEXTCLOUD_PI_DB_CONTAINER]}" sh -eu -c '
    test -n "${MYSQL_ROOT_PASSWORD:-}" && test -n "${MYSQL_DATABASE:-}"
    export MYSQL_PWD="$MYSQL_ROOT_PASSWORD"
    exec mariadb --protocol=tcp --host=127.0.0.1 -uroot -N --batch "$MYSQL_DATABASE" -e "SELECT COUNT(*) FROM information_schema.INNODB_TRX"
  '
}
cmd_upgrade_freeze_quiescence() {
  [[ $# == 1 ]] || invalid; reject_stdin; valid_id "$1" || invalid
  local id="$1" sample app caddy db service
  validate_host; freeze_require_current "$id"
  [[ "$(freeze_field phase)" == active && "$(freeze_table_hash)" == "$(freeze_field table_sha256)" ]] || die "upgrade freeze is not active or differs"
  ! /usr/bin/systemctl is-active --quiet "$background_jobs_timer" || die "background-job timer is active"
  service="$(/usr/bin/systemctl is-active "$background_jobs_service" 2>/dev/null || true)"
  [[ "$service" == inactive || "$service" == failed || "$service" == unknown ]] || die "background-job service is still running"
  /usr/bin/docker exec --user www-data "${P[NEXTCLOUD_PI_APP_CONTAINER]}" php /var/www/html/occ status | /usr/bin/grep -Eq '^[[:space:]]*-[[:space:]]*maintenance:[[:space:]]*true$' || die "Nextcloud maintenance mode is not on"
  for sample in 1 2; do
    app="$(freeze_socket_count "${P[NEXTCLOUD_PI_APP_CONTAINER]}")" || die "application sockets could not be inspected"
