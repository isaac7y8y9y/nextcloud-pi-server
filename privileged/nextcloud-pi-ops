cmd_db_cutover_recovered() {
  [[ $# == 3 ]] || invalid; reject_stdin
  local id="$1" fingerprint="$2" stage_fingerprint="$3"
  lock; validate_host; db_cutover_require "$id" "$fingerprint"; db_cutover_stage_bound "$id" "$stage_fingerprint"
  [[ "$(upgrade_stage_field "$id" phase)" == recovered && "$(db_cutover_field "$id" phase)" == source-ready ]] || die "database full recovery is incomplete"
