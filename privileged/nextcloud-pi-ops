readiness_state() { printf '%s/image-readiness/%s' "${P[NEXTCLOUD_PI_STATE_ROOT]}" "$1"; }
readiness_socket() { printf '%s/image-readiness-%s.sock' "${P[NEXTCLOUD_PI_SOCKET_ROOT]}" "$1"; }
readiness_args() { local id="$1" root socket group; root="$(readiness_root "$id")"; socket="$(readiness_socket "$id")"; group="$(/usr/bin/id -gn "${P[NEXTCLOUD_PI_DEPLOYMENT_USER]}")"; printf '%s\n' /usr/bin/dockerd "--host=unix://$socket" "--data-root=$root/data" "--exec-root=$root/exec" "--pidfile=$root/dockerd.pid" "--group=$group" "--containerd-namespace=nextcloud-pi-readiness-$id" "--containerd-plugins-namespace=nextcloud-pi-readiness-plugins-$id" --bridge=none --iptables=false --ip-forward=false --ip-masq=false --userland-proxy=false --log-level=error; }
verify_readiness() { local id="$1" state="$(readiness_state "$1")" pid start expected=() actual=() i; safe_dir "$state"; pid="$(<"$state/pid")"; start="$(<"$state/start")"; [[ "$pid" =~ ^[1-9][0-9]*$ && "$start" =~ ^[0-9]+$ && -d "/proc/$pid" && "$(/usr/bin/readlink -f "/proc/$pid/exe")" == /usr/bin/dockerd ]] || die "isolated daemon identity differs"; [[ "$(/usr/bin/awk '{print $22}' "/proc/$pid/stat")" == "$start" ]] || die "isolated daemon PID was reused"; mapfile -t expected < <(readiness_args "$id"); mapfile -d '' -t actual <"/proc/$pid/cmdline"; [[ "${#expected[@]}" == "${#actual[@]}" ]] || die "isolated daemon command differs"; for i in "${!expected[@]}"; do [[ "${expected[$i]}" == "${actual[$i]}" ]] || die "isolated daemon command differs"; done; printf '%s' "$pid"; }
cmd_readiness_check() { [[ $# == 2 ]] || invalid; reject_stdin; local id="$1" bytes="$2" root state socket available_bytes; valid_id "$id" && valid_size "$bytes" || invalid; validate_host; root="$(readiness_root "$id")"; state="$(readiness_state "$id")"; socket="$(readiness_socket "$id")"; [[ -x /usr/bin/dockerd && ! -L /usr/bin/dockerd && ! -e "$root" && ! -L "$root" && ! -e "$state" && ! -L "$state" && ! -e "$socket" && ! -L "$socket" ]] || die "readiness targets are unavailable"; available_bytes="$(available)"; (( available_bytes > bytes * 3 + 1073741824 )) || die "insufficient readiness space"; out state available; out id "$id"; out socket "$socket"; out available_bytes "$available_bytes"; }
cmd_readiness_start() { [[ $# == 1 ]] || invalid; reject_stdin; local id="$1" root state socket args=() pid='' attempt group; valid_id "$id" || invalid; lock; validate_host; root="$(readiness_root "$id")"; state="$(readiness_state "$id")"; socket="$(readiness_socket "$id")"; [[ ! -e "$root" && ! -L "$root" && ! -e "$state" && ! -L "$state" && ! -e "$socket" && ! -L "$socket" ]] || die "readiness lifecycle exists"; ensure_parent image-readiness; group="$(/usr/bin/id -gn "${P[NEXTCLOUD_PI_DEPLOYMENT_USER]}")"; /usr/bin/install -d -m 0710 -o root -g "$group" "${P[NEXTCLOUD_PI_SOCKET_ROOT]}"; /usr/bin/install -d -m 0700 -o root -g root "$root" "$state"; readiness_start_abort() { local status=$?; trap - EXIT HUP INT TERM; [[ "$pid" =~ ^[1-9][0-9]*$ ]] && /usr/bin/kill -TERM "$pid" 2>/dev/null || true; /usr/bin/rm -rf --one-file-system -- "$state" "$root"; /usr/bin/rm -f -- "$socket"; exit "$status"; }; trap readiness_start_abort EXIT HUP INT TERM; mapfile -t args < <(readiness_args "$id"); /usr/bin/nohup "${args[@]}" 9>&- </dev/null >"$state/dockerd.log" 2>&1 & pid=$!; printf '%s\n' "$pid" >"$state/pid"; for attempt in {1..20}; do [[ -r "/proc/$pid/stat" ]] && break; /usr/bin/sleep 1; done; [[ -r "/proc/$pid/stat" ]] || die "isolated daemon did not start"; /usr/bin/awk '{print $22}' "/proc/$pid/stat" >"$state/start"; /usr/bin/chmod 0600 "$state/pid" "$state/start"; for attempt in {1..60}; do [[ -S "$socket" ]] && /usr/bin/docker --host "unix://$socket" info >/dev/null 2>&1 && break; /usr/bin/sleep 1; done; [[ -S "$socket" ]] && /usr/bin/docker --host "unix://$socket" info >/dev/null 2>&1 || die "isolated daemon did not become ready"; verify_readiness "$id" >/dev/null; trap - EXIT HUP INT TERM; out state ready; out id "$id"; out socket "$socket"; }
cmd_readiness_status() { [[ $# == 1 ]] || invalid; reject_stdin; local id="$1" socket; valid_id "$id" || invalid; validate_host; socket="$(readiness_socket "$id")"; verify_readiness "$id" >/dev/null; [[ -S "$socket" && -z "$(/usr/bin/docker --host "unix://$socket" ps -aq)" ]] || die "isolated daemon is not empty"; out state ready; out id "$id"; out socket "$socket"; }
cmd_readiness_stop() { [[ $# == 1 ]] || invalid; reject_stdin; local id="$1" pid attempt; valid_id "$id" || invalid; lock; validate_host; [[ -e "$(readiness_state "$id")" || -L "$(readiness_state "$id")" ]] || { out state stopped; out id "$id"; return; }; pid="$(verify_readiness "$id")"; /usr/bin/kill -TERM "$pid"; for attempt in {1..30}; do /usr/bin/kill -0 "$pid" 2>/dev/null || break; /usr/bin/sleep 1; done; if /usr/bin/kill -0 "$pid" 2>/dev/null; then /usr/bin/kill -KILL "$pid"; for attempt in {1..5}; do /usr/bin/kill -0 "$pid" 2>/dev/null || break; /usr/bin/sleep 1; done; fi; ! /usr/bin/kill -0 "$pid" 2>/dev/null || die "isolated daemon did not stop"; out state stopped; out id "$id"; }
cmd_readiness_cleanup() { [[ $# == 1 ]] || invalid; reject_stdin; local id="$1" root state socket pid; valid_id "$id" || invalid; lock; validate_host; root="$(readiness_root "$id")"; state="$(readiness_state "$id")"; socket="$(readiness_socket "$id")"; if [[ -e "$state" || -L "$state" ]]; then safe_dir "$state"; if [[ -f "$state/pid" && ! -L "$state/pid" ]]; then pid="$(<"$state/pid")"; [[ "$pid" =~ ^[1-9][0-9]*$ ]] || die "isolated daemon PID is unsafe"; ! /usr/bin/kill -0 "$pid" 2>/dev/null || die "isolated daemon is still running"; fi; no_nested_mounts "$state" || die "readiness state contains a nested mount"; /usr/bin/rm -rf --one-file-system -- "$state"; fi; if [[ -e "$root" || -L "$root" ]]; then safe_dir "$root"; no_nested_mounts "$root" || die "readiness target contains a nested mount"; /usr/bin/rm -rf --one-file-system -- "$root"; fi; [[ ! -e "$socket" && ! -L "$socket" ]] || /usr/bin/rm -f -- "$socket"; out state absent; out id "$id"; }

drill_unit() { printf '/etc/systemd/system/nextcloud-pi-drill-%s.service' "$1"; }
cmd_drill_check() { [[ $# == 1 ]] || invalid; reject_stdin; valid_id "$1" || invalid; validate_host; [[ ! -e "$(drill_unit "$1")" && ! -L "$(drill_unit "$1")" ]] || die "drill unit exists"; out state available; out id "$1"; }
cmd_drill_apply() { [[ $# == 1 ]] || invalid; reject_stdin; local id="$1" unit required_unit; valid_id "$id" || invalid; lock; validate_host; unit="$(drill_unit "$id")"; required_unit="nextcloud-pi-drill-required-$id.service"; [[ ! -e "$unit" && ! -L "$unit" ]] || die "drill unit exists"; printf '[Unit]\nDescription=Disposable Nextcloud Pi drill\nRequires=%s\n[Service]\nType=oneshot\nExecStart=/usr/bin/true\n' "$required_unit" | /usr/bin/install -m 0644 -o root -g root /dev/stdin "$unit"; trap '/usr/bin/rm -f -- "$unit"; /usr/bin/systemctl daemon-reload >/dev/null 2>&1 || true' EXIT HUP INT TERM; /usr/bin/systemctl daemon-reload; if /usr/bin/systemctl start "nextcloud-pi-drill-$id.service" >/dev/null 2>&1; then die "drill dependency unexpectedly succeeded"; fi; /usr/bin/rm -f -- "$unit"; /usr/bin/systemctl daemon-reload; [[ ! -e "$unit" ]] || die "drill rollback failed"; trap - EXIT HUP INT TERM; out state rolledback; out id "$id"; }
cmd_drill_cleanup() { [[ $# == 1 ]] || invalid; reject_stdin; valid_id "$1" || invalid; lock; validate_host; [[ ! -L "$(drill_unit "$1")" ]] || die "drill unit is unsafe"; /usr/bin/rm -f -- "$(drill_unit "$1")"; /usr/bin/systemctl daemon-reload; out state absent; out id "$1"; }

load_policy
if [[ "${1:-}" == upgrade-freeze-boot-guard ]]; then
  [[ "$EUID" == 0 && -z "${SUDO_USER:-}" ]] || die "boot guard requires systemd root context"
