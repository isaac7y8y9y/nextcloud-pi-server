db_cutover_scan() {
  local root="$(db_cutover_root)" file id phase source candidate preserved
  [[ ! -e "$root" && ! -L "$root" ]] && return
  safe_dir "$root"
  for file in "$root"/*.tsv; do
    [[ -e "$file" || -L "$file" ]] || continue
    protected_file "$file" 0600
    id="${file##*/}"; id="${id%.tsv}"
    valid_id "$id" && [[ "$(metadata "$file" format)" == db-cutover-v1 && "$(metadata "$file" id)" == "$id" ]] || die "database cutover journal is invalid"
    phase="$(metadata "$file" phase)"
    case "$phase" in
      aborted|accepted|recovered) continue ;;
      preparing|prepared|detaching)
        source="${P[NEXTCLOUD_PI_STORAGE_MOUNT]}/nextcloud_db"
        [[ -d "$source" && ! -L "$source" && "$(/usr/bin/stat -c '%d:%i' "$source")" == "$(metadata "$file" source_inode)" ]] || die "source database directory differs during cutover"
        [[ "$(live_hash)" == "$(metadata "$file" pre_record_sha256)" && "$(upgrade_stage_compose_hash)" == "$(metadata "$file" pre_compose_sha256)" ]] || die "source configuration differs during cutover"
        ;;
      detached|switching|candidate-ready|starting|running|recovery-detaching|recovering|source-ready)
        [[ "$(metadata "$file" objects_removed)" == yes ]] || die "database containers were not durably detached"
        if [[ "$phase" == candidate-ready || "$phase" == starting || "$phase" == running ]]; then
          candidate="${P[NEXTCLOUD_PI_STORAGE_MOUNT]}/nextcloud_db"
          preserved="${P[NEXTCLOUD_PI_STORAGE_MOUNT]}/.nextcloud-db-before-$id"
          [[ -d "$candidate" && ! -L "$candidate" && "$(/usr/bin/stat -c '%d:%i' "$candidate")" == "$(metadata "$file" candidate_inode)" && -d "$preserved" && ! -L "$preserved" && "$(/usr/bin/stat -c '%d:%i' "$preserved")" == "$(metadata "$file" source_inode)" ]] || die "candidate database placement differs"
          [[ "$(live_hash)" == "$(metadata "$file" candidate_record_sha256)" && "$(upgrade_stage_compose_hash)" == "$(metadata "$file" candidate_compose_sha256)" ]] || die "candidate configuration differs during cutover"
        fi
        if [[ "$phase" == source-ready ]]; then
          source="${P[NEXTCLOUD_PI_STORAGE_MOUNT]}/nextcloud_db"
          [[ -d "$source" && ! -L "$source" && "$(live_hash)" == "$(metadata "$file" pre_record_sha256)" && "$(upgrade_stage_compose_hash)" == "$(metadata "$file" pre_compose_sha256)" ]] || die "restored source database or configuration differs"
        fi
        ;;
      *) die "database cutover phase is invalid" ;;
    esac
  done
}
db_cutover_boot_guard() { db_cutover_scan; }
db_cutover_startup_guard() {
  local root="$(db_cutover_root)" file phase
  db_cutover_scan
  [[ ! -e "$root" && ! -L "$root" ]] && return
  for file in "$root"/*.tsv; do
    [[ -e "$file" || -L "$file" ]] || continue
    phase="$(metadata "$file" phase)"
    case "$phase" in aborted|accepted|recovered|candidate-ready|starting|running|source-ready) ;; *) die "database cutover has not reached a safe startup phase" ;; esac
