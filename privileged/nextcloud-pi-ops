  db_cutover_old_objects_absent "$id"
  db_cutover_rewrite "$id" detached yes "$(db_cutover_field "$id" candidate_inode)" "$(db_cutover_field "$id" candidate_digest)"
  out phase detached; out id "$id"
}
cmd_db_cutover_switch() {
  [[ $# == 3 ]] || invalid; reject_stdin
  local id="$1" fingerprint="$2" stage_fingerprint="$3" phase data live preserved source_inode candidate_inode
  lock; validate_host; db_cutover_require "$id" "$fingerprint"; db_cutover_stage_bound "$id" "$stage_fingerprint"
  [[ "$(upgrade_stage_field "$id" phase)" == runtime-may-have-changed ]] || die "full recovery boundary was not recorded"
  phase="$(db_cutover_field "$id" phase)"
  [[ "$phase" == detached || "$phase" == switching ]] || die "database stage cannot switch"
  db_cutover_old_objects_absent "$id"
  data="$(db_cutover_path "$id")"; live="${P[NEXTCLOUD_PI_STORAGE_MOUNT]}/nextcloud_db"; preserved="${P[NEXTCLOUD_PI_STORAGE_MOUNT]}/.nextcloud-db-before-$id"
  source_inode="$(db_cutover_field "$id" source_inode)"; candidate_inode="$(db_cutover_field "$id" candidate_inode)"
  if [[ "$phase" == detached ]]; then
    [[ -d "$live" && ! -L "$live" && "$(db_cutover_inode "$live")" == "$source_inode" && -d "$data" && ! -L "$data" && "$(db_cutover_inode "$data")" == "$candidate_inode" && ! -e "$preserved" && ! -L "$preserved" ]] || die "database switch source paths differ"
    [[ "$(db_cutover_digest "$data")" == "$(db_cutover_field "$id" candidate_digest)" ]] || die "prepared database content changed"
    db_cutover_rewrite "$id" switching yes "$candidate_inode" "$(db_cutover_field "$id" candidate_digest)"
  fi
  if [[ -d "$live" && ! -L "$live" && "$(db_cutover_inode "$live")" == "$source_inode" && ! -e "$preserved" && ! -L "$preserved" ]]; then
    /usr/bin/mv -T --no-clobber -- "$live" "$preserved"
    /usr/bin/sync -f "${P[NEXTCLOUD_PI_STORAGE_MOUNT]}"
  fi
  [[ -d "$preserved" && ! -L "$preserved" && "$(db_cutover_inode "$preserved")" == "$source_inode" ]] || die "preserved source database differs"
  if [[ -d "$data" && ! -L "$data" && "$(db_cutover_inode "$data")" == "$candidate_inode" && ! -e "$live" && ! -L "$live" ]]; then
    /usr/bin/mv -T --no-clobber -- "$data" "$live"
    /usr/bin/sync -f "${P[NEXTCLOUD_PI_STORAGE_MOUNT]}"
  fi
  [[ -d "$live" && ! -L "$live" && "$(db_cutover_inode "$live")" == "$candidate_inode" && ! -e "$data" && ! -L "$data" ]] || die "candidate database placement is incomplete"
  out phase switching; out id "$id"
}
