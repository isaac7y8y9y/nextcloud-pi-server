cmd_db_cutover_detach() {
  [[ $# == 3 ]] || invalid; reject_stdin
  local id="$1" fingerprint="$2" stage_fingerprint="$3" phase name key expected actual
  lock; validate_host; db_cutover_require "$id" "$fingerprint"; db_cutover_stage_bound "$id" "$stage_fingerprint"
  [[ "$(upgrade_stage_field "$id" phase)" == prepared ]] || die "activation stage is not prepared"
  phase="$(db_cutover_field "$id" phase)"
  [[ "$phase" == prepared || "$phase" == detaching || "$phase" == detached ]] || die "database stage cannot detach"
  [[ "$(live_hash)" == "$(db_cutover_field "$id" pre_record_sha256)" && "$(upgrade_stage_compose_hash)" == "$(db_cutover_field "$id" pre_compose_sha256)" ]] || die "source configuration changed before detach"
