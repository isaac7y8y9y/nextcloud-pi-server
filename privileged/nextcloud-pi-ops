    case "$key" in app) name="${P[NEXTCLOUD_PI_APP_CONTAINER]}";; db) name="${P[NEXTCLOUD_PI_DB_CONTAINER]}";; caddy) name="${P[NEXTCLOUD_PI_CADDY_CONTAINER]}";; esac
    expected="$(db_cutover_field "$id" "${key}_container_id")"
    actual="$(/usr/bin/docker inspect --format '{{.Id}} {{.State.Running}}' "$name" 2>/dev/null || true)"
    if [[ "$actual" == "$expected true" ]]; then
      /usr/bin/docker stop --time 120 "$name" >/dev/null || die "source container did not stop cleanly"
      actual="$(/usr/bin/docker inspect --format '{{.Id}} {{.State.Running}}' "$name")"
    fi
    [[ -z "$actual" || "$actual" == "$expected false" ]] || die "source container did not stop or identity changed"
