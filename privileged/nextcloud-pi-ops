#!/bin/bash
set -euo pipefail

# The only passwordless root entry point. Inputs select fixed logical actions;
# all authority values and paths come from the root-owned policy.
readonly POLICY=/etc/nextcloud-pi/privileged-policy.conf
readonly MANIFEST=/etc/nextcloud-pi/bundle-manifest.tsv
readonly HELPER=/usr/local/libexec/nextcloud-pi-ops
readonly VALIDATOR=/usr/local/libexec/nextcloud-pi-validate-active-images
readonly ACTIVE_RECORD=/etc/nextcloud-pi/active-images.env
readonly LOCK=/run/lock/nextcloud-pi-ops.lock
ACTIVE_PREPARE_ABORT_TX=''
export PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C LANG=C
umask 077
unset CDPATH ENV BASH_ENV GLOBIGNORE SHELLOPTS 2>/dev/null || true

die() { printf 'nextcloud-pi-ops: %s\n' "$1" >&2; exit 1; }
invalid() { printf 'nextcloud-pi-ops: invalid command or arguments\n' >&2; exit 2; }
out() { printf '%s\t%s\n' "$1" "$2"; }
mode() { /usr/bin/stat -c '%a' "$1"; }
uid() { /usr/bin/stat -c '%u' "$1"; }
gid() { /usr/bin/stat -c '%g' "$1"; }
hash() { /usr/bin/sha256sum "$1" | /usr/bin/awk '{print $1}'; }
valid_id() { [[ "$1" =~ ^[0-9]{8}T[0-9]{6}Z-[0-9]+$ ]]; }
valid_hash() { [[ "$1" =~ ^[0-9a-f]{64}$ ]]; }

declare -A P=()
allowed_policy_key() {
  case "$1" in
    NEXTCLOUD_PI_POLICY_FORMAT|NEXTCLOUD_PI_BUNDLE_VERSION|NEXTCLOUD_PI_DEPLOYMENT_USER|NEXTCLOUD_PI_SYSTEM_HOSTNAME|NEXTCLOUD_PI_PROJECT_DIR|NEXTCLOUD_PI_STORAGE_MOUNT|NEXTCLOUD_PI_STORAGE_TYPE|NEXTCLOUD_PI_STORAGE_UUID|NEXTCLOUD_PI_IMAGE_PLATFORM|NEXTCLOUD_PI_SERVICE_NAME|NEXTCLOUD_PI_APP_CONTAINER|NEXTCLOUD_PI_DB_CONTAINER|NEXTCLOUD_PI_CADDY_CONTAINER|NEXTCLOUD_PI_CADDY_DATA_VOLUME|NEXTCLOUD_PI_CADDY_CONFIG_VOLUME|NEXTCLOUD_PI_STATE_ROOT|NEXTCLOUD_PI_SOCKET_ROOT|NEXTCLOUD_PI_RUNTIME_RECOVERY_PREFIX|NEXTCLOUD_PI_IMAGE_READINESS_PREFIX|NEXTCLOUD_PI_MAX_STAGING_BYTES) return 0 ;;
    *) return 1 ;;
  esac
}
protected_file() {
  local path="$1" expected="$2"
  [[ -f "$path" && ! -L "$path" && "$(uid "$path")" == 0 && "$(gid "$path")" == 0 && "$(mode "$path")" == "${expected#0}" ]] || die "protected file is unsafe"
}
protected_parents() {
  local path="$1" parent
  parent="$(/usr/bin/dirname -- "$path")"
  while [[ "$parent" != / ]]; do
    [[ -d "$parent" && ! -L "$parent" && "$(uid "$parent")" == 0 && "$(gid "$parent")" == 0 ]] || die "protected parent is unsafe"
    (( (8#$(mode "$parent") & 8#022) == 0 )) || die "protected parent is writable"
    parent="$(/usr/bin/dirname -- "$parent")"
  done
}
load_policy() {
  local line key value count=0
  protected_file "$POLICY" 0600; protected_parents "$POLICY"
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^([A-Z][A-Z0-9_]*)=([^[:space:]]+)$ ]] || die "policy schema is invalid"
    key="${BASH_REMATCH[1]}"; value="${BASH_REMATCH[2]}"
    allowed_policy_key "$key" || die "policy key is invalid"
    [[ -z "${P[$key]+x}" ]] || die "policy has a duplicate key"
    P[$key]="$value"; count=$((count + 1))
  done <"$POLICY"
  (( count == 20 )) || die "policy is incomplete"
  [[ "${P[NEXTCLOUD_PI_POLICY_FORMAT]}" == nextcloud-pi-privileged-policy-v1 && "${P[NEXTCLOUD_PI_BUNDLE_VERSION]}" =~ ^[1-9][0-9]*$ ]] || die "policy format is invalid"
  [[ "${P[NEXTCLOUD_PI_DEPLOYMENT_USER]}" =~ ^[A-Za-z_][A-Za-z0-9_.-]*$ && "${P[NEXTCLOUD_PI_SYSTEM_HOSTNAME]}" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*$ ]] || die "policy identity is invalid"
  [[ "${P[NEXTCLOUD_PI_PROJECT_DIR]}" =~ ^/[A-Za-z0-9._/-]+$ && "${P[NEXTCLOUD_PI_PROJECT_DIR]##*/}" == nextcloud-docker ]] || die "policy project is invalid"
  [[ "${P[NEXTCLOUD_PI_STORAGE_MOUNT]}" =~ ^/[A-Za-z0-9._/-]+$ && "${P[NEXTCLOUD_PI_STORAGE_TYPE]}" == ext4 && "${P[NEXTCLOUD_PI_STORAGE_UUID]}" =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]] || die "policy storage is invalid"
  [[ "${P[NEXTCLOUD_PI_STATE_ROOT]}" == /var/lib/nextcloud-pi-ops && "${P[NEXTCLOUD_PI_SOCKET_ROOT]}" == /run/nextcloud-pi-ops && "${P[NEXTCLOUD_PI_MAX_STAGING_BYTES]}" =~ ^[1-9][0-9]*$ ]] || die "policy roots are invalid"
}
require_caller() { [[ "$EUID" == 0 && "${SUDO_USER:-}" == "${P[NEXTCLOUD_PI_DEPLOYMENT_USER]}" ]] || die "caller is not authorized"; }
validate_manifest() {
  local kind logical source installed expected digest extra format='' version='' seen='|'
  protected_file "$MANIFEST" 0600; protected_parents "$MANIFEST"
  while IFS=$'\t' read -r kind logical source installed expected digest extra || [[ -n "$kind" ]]; do
    [[ -z "$kind" || "$kind" == \#* ]] && continue
    case "$kind" in
      format) [[ "$logical" == nextcloud-pi-bundle-manifest-v1 && -z "${source:-}" ]] || die "manifest format is invalid"; format="$logical" ;;
      version) [[ "$logical" == "${P[NEXTCLOUD_PI_BUNDLE_VERSION]}" && -z "${source:-}" ]] || die "manifest version is invalid"; version="$logical" ;;
      file)
        [[ "$logical" =~ ^[a-z-]+$ && "$installed" == /* && "$expected" =~ ^0[0-7]{3}$ && "$digest" =~ ^[0-9a-f]{64}$ && -z "${extra:-}" && "$seen" != *"|$logical|"* ]] || die "manifest entry is invalid"
        protected_file "$installed" "$expected"; protected_parents "$installed"; [[ "$(hash "$installed")" == "$digest" ]] || die "installed bundle differs"; seen+="$logical|"
        ;;
      *) die "manifest schema is invalid" ;;
    esac
  done <"$MANIFEST"
  [[ "$format" == nextcloud-pi-bundle-manifest-v1 && "$version" == "${P[NEXTCLOUD_PI_BUNDLE_VERSION]}" ]] || die "manifest is incomplete"
  for logical in privileged-helper active-image-validator compose-launcher nextcloud-unit docker-storage-drop-in; do [[ "$seen" == *"|$logical|"* ]] || die "manifest lacks required file"; done
}
validate_installation() {
  protected_file "$HELPER" 0700; protected_parents "$HELPER"; validate_manifest
  [[ -d "${P[NEXTCLOUD_PI_STATE_ROOT]}" && ! -L "${P[NEXTCLOUD_PI_STATE_ROOT]}" && "$(uid "${P[NEXTCLOUD_PI_STATE_ROOT]}")" == 0 && "$(mode "${P[NEXTCLOUD_PI_STATE_ROOT]}")" == 700 ]] || die "state root is unsafe"
}
validate_host() {
  local target type volume
  [[ "$(/usr/bin/hostname)" == "${P[NEXTCLOUD_PI_SYSTEM_HOSTNAME]}" ]] || die "hostname differs"
  target="$(/usr/bin/findmnt -rn --target "${P[NEXTCLOUD_PI_STORAGE_MOUNT]}" -o TARGET)"; type="$(/usr/bin/findmnt -rn --target "${P[NEXTCLOUD_PI_STORAGE_MOUNT]}" -o FSTYPE)"; volume="$(/usr/bin/findmnt -rn --target "${P[NEXTCLOUD_PI_STORAGE_MOUNT]}" -o UUID)"
  [[ "$target" == "${P[NEXTCLOUD_PI_STORAGE_MOUNT]}" && "$type" == ext4 && "${volume,,}" == "${P[NEXTCLOUD_PI_STORAGE_UUID],,}" ]] || die "storage identity differs"
}
reject_stdin() { local byte; if [[ ! -t 0 ]] && IFS= read -r -n 1 -t 0.05 byte; then invalid; fi; return 0; }
valid_size() { [[ "$1" =~ ^[1-9][0-9]*$ ]] && (( 10#$1 <= 10#${P[NEXTCLOUD_PI_MAX_STAGING_BYTES]} )); }
lock() { exec 9>"$LOCK"; /usr/bin/flock -w 30 9 || die "another operation is running"; [[ "$(uid "$LOCK")" == 0 && "$(mode "$LOCK")" == 600 ]] || die "lock is unsafe"; }
state_dir() { printf '%s/%s' "${P[NEXTCLOUD_PI_STATE_ROOT]}" "$1"; }
safe_dir() { [[ -d "$1" && ! -L "$1" && "$(uid "$1")" == 0 && "$(gid "$1")" == 0 && "$(mode "$1")" == 700 ]] || die "state directory is unsafe"; }
no_nested_mounts() { /usr/bin/findmnt -rn -o TARGET | /usr/bin/awk -v path="$1" '$0 == path || index($0, path "/") == 1 { bad = 1 } END { exit bad }'; }
ensure_parent() { local path="$(state_dir "$1")"; if [[ -e "$path" || -L "$path" ]]; then safe_dir "$path"; else /usr/bin/install -d -m 0700 -o root -g root "$path"; fi; }
read_exact() {
  local target="$1" size="$2" extra="$1.extra"
  /usr/bin/dd iflag=fullblock bs=1 count="$size" status=none of="$target" || die "input read failed"
  [[ "$(/usr/bin/stat -c '%s' "$target")" == "$size" ]] || die "input is truncated"
  /usr/bin/dd bs=1 count=1 status=none of="$extra" 2>/dev/null || die "input trailer check failed"
  [[ "$(/usr/bin/stat -c '%s' "$extra")" == 0 ]] || die "input has trailing bytes"
  /usr/bin/rm -f -- "$extra"
}
resource_path() { case "$1" in nextcloud-unit) echo /etc/systemd/system/nextcloud.service;; docker-storage-drop-in) echo /etc/systemd/system/docker.service.d/nextcloud-storage.conf;; compose-launcher) echo /usr/local/libexec/nextcloud-pi-compose-start;; active-image-validator) echo "$VALIDATOR";; active-image-record) echo "$ACTIVE_RECORD";; privileged-helper) echo "$HELPER";; privileged-policy) echo "$POLICY";; sudoers-policy) echo /etc/sudoers.d/nextcloud-pi-automation;; *) invalid;; esac; }
resource_mode() { case "$1" in nextcloud-unit|docker-storage-drop-in) echo 0644;; compose-launcher|active-image-validator|privileged-helper) echo 0700;; active-image-record|privileged-policy) echo 0600;; sudoers-policy) echo 0440;; *) invalid;; esac; }
live_hash() { if [[ -f "$ACTIVE_RECORD" && ! -L "$ACTIVE_RECORD" ]]; then hash "$ACTIVE_RECORD"; elif [[ ! -e "$ACTIVE_RECORD" && ! -L "$ACTIVE_RECORD" ]]; then echo missing; else die "active record is unsafe"; fi; }
metadata() { /usr/bin/awk -F $'\t' -v key="$2" '$1 == key { n++; v=$2 } END { if (n == 1) print v; else exit 1 }' "$1"; }
active_root() { state_dir active-record; }
active_tx() { printf '%s/%s' "$(active_root)" "$1"; }
active_marker() { state_dir active-record-current; }
write_active_meta() { printf 'format\tactive-record-v1\nstate\t%s\npre_sha256\t%s\ncandidate_sha256\t%s\nsize\t%s\n' "$2" "$3" "$4" "$5" >"$1.new"; /usr/bin/chmod 0600 "$1.new"; /usr/bin/mv -f "$1.new" "$1"; }
require_active_tx() { local tx="$(active_tx "$1")" marker="$(active_marker)"; valid_id "$1" || invalid; safe_dir "$tx"; protected_file "$marker" 0600; [[ "$(<"$marker")" == "$1" ]] || die "another active transaction owns the record"; protected_file "$tx/metadata.tsv" 0600; }
install_record() { local temp; temp="$(/usr/bin/mktemp /etc/nextcloud-pi/.active-images.XXXXXX)"; /usr/bin/install -m 0600 -o root -g root "$1" "$temp"; /usr/bin/mv -f "$temp" "$ACTIVE_RECORD"; }
active_prepare_abort() { local status="$1" tx="$ACTIVE_PREPARE_ABORT_TX"; trap - EXIT HUP INT TERM; [[ -z "$tx" ]] || /usr/bin/rm -rf --one-file-system -- "$tx"; exit "$status"; }

cmd_version() { [[ $# == 0 ]] || invalid; reject_stdin; out version "${P[NEXTCLOUD_PI_BUNDLE_VERSION]}"; out manifest_sha256 "$(hash "$MANIFEST")"; }
cmd_check() { local program resolved; [[ $# == 0 ]] || invalid; reject_stdin; validate_host; for program in /bin/bash /usr/bin/awk /usr/bin/basename /usr/bin/cp /usr/bin/dd /usr/bin/df /usr/bin/dirname /usr/bin/docker /usr/bin/dockerd /usr/bin/du /usr/bin/find /usr/bin/findmnt /usr/bin/flock /usr/bin/id /usr/bin/install /usr/bin/kill /usr/bin/mktemp /usr/bin/nohup /usr/bin/python3 /usr/bin/readlink /usr/bin/rm /usr/bin/sha256sum /usr/bin/sleep /usr/bin/stat /usr/bin/systemctl /usr/bin/tail /usr/bin/tar /usr/bin/tr; do [[ -x "$program" ]] || die "required program is unavailable"; resolved="$(/usr/bin/readlink -f "$program")"; [[ -f "$resolved" && ! -L "$resolved" && "$(uid "$resolved")" == 0 && "$(gid "$resolved")" == 0 ]] || die "required program is unsafe"; done; out status ok; }
cmd_protected_state() { [[ $# == 1 && "$1" != -* ]] || invalid; reject_stdin; local path="$(resource_path "$1")" expected="$(resource_mode "$1")"; if [[ ! -e "$path" && ! -L "$path" ]]; then out state missing; out name "$1"; return; fi; protected_file "$path" "$expected"; protected_parents "$path"; out state present; out name "$1"; out sha256 "$(hash "$path")"; out uid 0; out gid 0; out mode "$expected"; }
cmd_active_images_state() { [[ $# == 0 ]] || invalid; reject_stdin; "$VALIDATOR"; out status ok; out mode "$(/usr/bin/awk -F= '$1 == "NEXTCLOUD_ACTIVE_IMAGES_MODE" { print $2 }' "$ACTIVE_RECORD")"; out sha256 "$(hash "$ACTIVE_RECORD")"; }
cmd_service() { [[ $# == 1 ]] || invalid; reject_stdin; lock; validate_host; case "$1" in start|restart) /usr/bin/systemctl "$1" "${P[NEXTCLOUD_PI_SERVICE_NAME]}"; /usr/bin/systemctl is-active --quiet "${P[NEXTCLOUD_PI_SERVICE_NAME]}" || die "service is not active";; stop) /usr/bin/systemctl stop "${P[NEXTCLOUD_PI_SERVICE_NAME]}"; [[ "$(/usr/bin/systemctl is-active "${P[NEXTCLOUD_PI_SERVICE_NAME]}" 2>/dev/null || true)" =~ ^(inactive|failed)$ ]] || die "service did not stop";; *) invalid;; esac; out state "$1"; }
cmd_active_prepare() { [[ $# == 3 ]] || invalid; local id="$1" expected="$2" size="$3" tx marker pre; valid_id "$id" && valid_hash "$expected" && valid_size "$size" || invalid; (( size <= 65536 )) || invalid; lock; validate_host; marker="$(active_marker)"; tx="$(active_tx "$id")"; [[ ! -e "$marker" && ! -L "$marker" && ! -e "$tx" && ! -L "$tx" ]] || die "active transaction is already unresolved"; ensure_parent active-record; /usr/bin/install -d -m 0700 -o root -g root "$tx"; ACTIVE_PREPARE_ABORT_TX="$tx"; trap 'active_prepare_abort "$?"' EXIT HUP INT TERM; read_exact "$tx/candidate" "$size"; [[ "$(hash "$tx/candidate")" == "$expected" ]] || die "candidate hash differs"; "$VALIDATOR" --record "$tx/candidate"; pre="$(live_hash)"; if [[ "$pre" == missing ]]; then : >"$tx/absent"; /usr/bin/chmod 0600 "$tx/absent"; else "$VALIDATOR"; /usr/bin/cp -p "$ACTIVE_RECORD" "$tx/snapshot"; fi; write_active_meta "$tx/metadata.tsv" prepared "$pre" "$expected" "$size"; printf '%s\n' "$id" >"$marker"; /usr/bin/chmod 0600 "$marker"; trap - EXIT HUP INT TERM; ACTIVE_PREPARE_ABORT_TX=''; out state prepared; out id "$id"; }
cmd_active_apply() { [[ $# == 1 ]] || invalid; reject_stdin; local id="$1" tx meta pre candidate size live; lock; require_active_tx "$id"; tx="$(active_tx "$id")"; meta="$tx/metadata.tsv"; pre="$(metadata "$meta" pre_sha256)"; candidate="$(metadata "$meta" candidate_sha256)"; size="$(metadata "$meta" size)"; [[ "$(metadata "$meta" state)" == prepared && "$(hash "$tx/candidate")" == "$candidate" ]] || die "active transaction is not prepared"; live="$(live_hash)"; if [[ "$live" == "$candidate" ]]; then "$VALIDATOR"; write_active_meta "$meta" applied "$pre" "$candidate" "$size"; out state applied; out id "$id"; return; fi; [[ "$live" == "$pre" ]] || die "active record pre-state changed"; "$VALIDATOR" --record "$tx/candidate"; install_record "$tx/candidate"; "$VALIDATOR"; write_active_meta "$meta" applied "$pre" "$candidate" "$size"; out state applied; out id "$id"; }
cmd_active_rollback() { [[ $# == 1 ]] || invalid; reject_stdin; local id="$1" tx meta pre candidate size live state; lock; require_active_tx "$id"; tx="$(active_tx "$id")"; meta="$tx/metadata.tsv"; pre="$(metadata "$meta" pre_sha256)"; candidate="$(metadata "$meta" candidate_sha256)"; size="$(metadata "$meta" size)"; state="$(metadata "$meta" state)"; live="$(live_hash)"; [[ "$state" == prepared || "$state" == applied || "$state" == rolledback ]] || die "active transaction state is invalid"; if [[ "$live" == "$candidate" ]]; then if [[ "$pre" == missing ]]; then /usr/bin/rm -f -- "$ACTIVE_RECORD"; else install_record "$tx/snapshot"; "$VALIDATOR"; fi; elif [[ "$live" != "$pre" ]]; then die "active record changed outside transaction"; fi; [[ "$(live_hash)" == "$pre" ]] || die "rollback verification failed"; write_active_meta "$meta" rolledback "$pre" "$candidate" "$size"; out state rolledback; out id "$id"; }
cmd_active_commit() { [[ $# == 1 ]] || invalid; reject_stdin; local id="$1" tx meta state pre candidate marker; valid_id "$id" || invalid; lock; marker="$(active_marker)"; protected_file "$marker" 0600; [[ "$(<"$marker")" == "$id" ]] || die "another active transaction owns the record"; tx="$(active_tx "$id")"; if [[ ! -e "$tx" && ! -L "$tx" ]]; then /usr/bin/rm -f -- "$marker"; out state committed; out id "$id"; return; fi; safe_dir "$tx"; meta="$tx/metadata.tsv"; protected_file "$meta" 0600; state="$(metadata "$meta" state)"; pre="$(metadata "$meta" pre_sha256)"; candidate="$(metadata "$meta" candidate_sha256)"; if [[ "$state" == applied ]]; then [[ "$(live_hash)" == "$candidate" ]] || die "applied record changed"; elif [[ "$state" == rolledback ]]; then [[ "$(live_hash)" == "$pre" ]] || die "rolled-back record changed"; else die "active transaction is unresolved"; fi; /usr/bin/rm -rf --one-file-system -- "$tx"; /usr/bin/rm -f -- "$marker"; out state committed; out id "$id"; }

runtime_sources() { local data caddy; data="${P[NEXTCLOUD_PI_STORAGE_MOUNT]}/nextcloud"; caddy="$(/usr/bin/docker volume inspect "${P[NEXTCLOUD_PI_CADDY_DATA_VOLUME]}" --format '{{.Mountpoint}}')"; printf '%s\n' "$data" "$caddy" "$(/usr/bin/docker volume inspect "${P[NEXTCLOUD_PI_CADDY_CONFIG_VOLUME]}" --format '{{.Mountpoint}}')"; }
recovery_root() { printf '%s/%s%s' "${P[NEXTCLOUD_PI_STORAGE_MOUNT]}" "${P[NEXTCLOUD_PI_RUNTIME_RECOVERY_PREFIX]}" "$1"; }
recovery_state() { printf '%s/runtime-recovery/%s' "${P[NEXTCLOUD_PI_STATE_ROOT]}" "$1"; }
available() { /usr/bin/df -B1 --output=avail "${P[NEXTCLOUD_PI_STORAGE_MOUNT]}" | /usr/bin/tail -1 | /usr/bin/tr -d '[:space:]'; }
safe_recovery_root() { local id="${1#"${P[NEXTCLOUD_PI_STORAGE_MOUNT]}/${P[NEXTCLOUD_PI_RUNTIME_RECOVERY_PREFIX]}"}"; valid_id "$id" || die "recovery root is invalid"; safe_dir "$1"; }
cmd_runtime_backup_size() { [[ $# == 0 ]] || invalid; reject_stdin; validate_host; local labels=(nextcloud caddy-data caddy-config) paths=() index bytes; mapfile -t paths < <(runtime_sources); for index in 0 1 2; do [[ -d "${paths[$index]}" && ! -L "${paths[$index]}" ]] || die "runtime source is unsafe"; bytes="$(/usr/bin/du -sb "${paths[$index]}" | /usr/bin/awk '{print $1}')"; out "${labels[$index]}_bytes" "$bytes"; done; }
cmd_runtime_backup_stream() { [[ $# == 1 ]] || invalid; local dataset="$1" paths=() source parent name; case "$dataset" in nextcloud|caddy-data|caddy-config);; *) invalid;; esac; validate_host; mapfile -t paths < <(runtime_sources); case "$dataset" in nextcloud) source="${paths[0]}"; parent="$(/usr/bin/dirname "$source")"; name="$(/usr/bin/basename "$source")";; caddy-data) source="${paths[1]}"; parent="$source"; name=.; ;; caddy-config) source="${paths[2]}"; parent="$source"; name=.; ;; esac; [[ -d "$source" && ! -L "$source" ]] || die "runtime source is unsafe"; exec /usr/bin/tar --numeric-owner --acls --xattrs -cpf - -C "$parent" "$name"; }
cmd_recovery_check() { [[ $# == 2 ]] || invalid; reject_stdin; local id="$1" need="$2" root bytes; valid_id "$id" && valid_size "$need" || invalid; validate_host; root="$(recovery_root "$id")"; [[ ! -e "$root" && ! -L "$root" && ! -e "$(recovery_state "$id")" && ! -L "$(recovery_state "$id")" ]] || die "recovery lifecycle exists"; bytes="$(available)"; [[ "$bytes" =~ ^[0-9]+$ ]] && (( bytes > need )) || die "insufficient recovery space"; out state available; out id "$id"; out available_bytes "$bytes"; }
cmd_recovery_prepare() { [[ $# == 1 ]] || invalid; reject_stdin; local id="$1" root state; valid_id "$id" || invalid; lock; validate_host; root="$(recovery_root "$id")"; state="$(recovery_state "$id")"; [[ ! -e "$root" && ! -L "$root" && ! -e "$state" && ! -L "$state" ]] || die "recovery lifecycle exists"; ensure_parent runtime-recovery; /usr/bin/install -d -m 0700 -o root -g root "$state" "$root" "$root/nextcloud" "$root/caddy-data" "$root/caddy-config" "$root/mariadb-data"; printf 'format\truntime-recovery-v1\nstate\tprepared\n' >"$state/metadata.tsv"; /usr/bin/chmod 0600 "$state/metadata.tsv"; out state prepared; out id "$id"; out available_bytes "$(available)"; }
validate_archive() { /usr/bin/python3 - "$1" <<'PY'
import posixpath, stat, sys, tarfile
with tarfile.open(sys.argv[1], 'r:*') as archive:
    seen=set()
    for member in archive:
        name=member.name; normal=posixpath.normpath(name)
        # GNU tar represents an archive made with "-C source ." using this
        # harmless root-directory member. It is needed for the fixed Caddy
        # volume streams; no other spelling or file type is accepted.
        if normal == '.':
            if name not in ('.', './') or not member.isdir() or normal in seen or member.uid < 0 or member.gid < 0 or member.mode & (stat.S_ISUID|stat.S_ISGID|stat.S_IWOTH): raise SystemExit(1)
            seen.add(normal)
            continue
        if not name or name.startswith('/') or normal in ('', '..') or normal.startswith('../') or normal in seen: raise SystemExit(1)
        seen.add(normal)
        sticky_root_dir = member.isdir() and member.uid == 0 and member.gid == 0 and member.mode & stat.S_ISVTX and not member.mode & (stat.S_ISUID|stat.S_ISGID)
        if member.isdev() or member.isfifo() or member.uid < 0 or member.gid < 0 or ((not member.issym() and not member.islnk()) and member.mode & (stat.S_ISUID|stat.S_ISGID|stat.S_IWOTH) and not sticky_root_dir): raise SystemExit(1)
        if member.issym() or member.islnk():
            target=member.linkname
            resolved=posixpath.normpath(posixpath.join(posixpath.dirname(normal),target)) if member.issym() else posixpath.normpath(target)
            if not target or target.startswith('/') or resolved == '..' or resolved.startswith('../'): raise SystemExit(1)
PY
}
cmd_recovery_restore() { [[ $# == 4 ]] || invalid; local id="$1" dataset="$2" expected="$3" size="$4" root state dest archive; valid_id "$id" && valid_hash "$expected" && valid_size "$size" || invalid; case "$dataset" in nextcloud|caddy-data|caddy-config);; *) invalid;; esac; lock; validate_host; root="$(recovery_root "$id")"; state="$(recovery_state "$id")"; safe_recovery_root "$root"; safe_dir "$state"; dest="$root/$dataset"; safe_dir "$dest"; [[ ! -e "$state/$dataset.complete" ]] || die "dataset already restored"; archive="$state/$dataset.tar"; read_exact "$archive" "$size"; [[ "$(hash "$archive")" == "$expected" ]] || die "archive hash differs"; validate_archive "$archive" || die "archive namespace is unsafe"; [[ -z "$(/usr/bin/find "$dest" -mindepth 1 -print -quit)" ]] || die "restore destination is not empty"; /usr/bin/tar --numeric-owner --acls --xattrs -xpf "$archive" -C "$dest"; /usr/bin/tar --compare --numeric-owner --acls --xattrs -f "$archive" -C "$dest" >/dev/null || die "restore differs"; printf '%s\n' "$expected" >"$state/$dataset.complete"; /usr/bin/chmod 0600 "$state/$dataset.complete"; /usr/bin/rm -f -- "$archive"; out state restored; out id "$id"; out dataset "$dataset"; }
